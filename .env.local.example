VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# Opcional — monitoreo de errores en producción. Sin esto configurado, la app
# funciona igual, solo que sin reportar errores a Sentry.
VITE_SENTRY_DSN=https://<clave>@<org>.ingest.<region>.sentry.io/<proyecto>

# Opcional — vuelve a mostrar en la interfaz todo lo relacionado al modelo
# SaaS/multi-óptica (Suscripción/Facturas en Mensajes, etc.), oculto por
# defecto mientras dure el anteproyecto de tesis. No afecta la base de datos
# ni el aislamiento multi-tenant real, solo qué se renderiza.
VITE_MOSTRAR_SAAS=true
